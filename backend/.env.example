# =============================================================================
# Spider-Sense Environment Configuration Template
# =============================================================================

# Database (SQLite default for zero-config local development)
DATABASE_URL=sqlite:///./spider_sense.db

# Security & API Secrets
SECRET_KEY=your-random-secret-key-here
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bright Data API Configuration
# Get your API key from: https://brightdata.com/cp/setting/customer/tokens
BRIGHT_DATA_API_KEY=your_bright_data_api_token_here

# Bright Data Scraper Studio Custom Collector IDs
# Create/view your custom collectors at: https://brightdata.com/cp/scrapers
BRIGHT_DATA_COLLECTOR_GOOGLE=c_your_google_collector_id
BRIGHT_DATA_COLLECTOR_AMAZON=c_your_amazon_collector_id
BRIGHT_DATA_COLLECTOR_WALMART=c_your_walmart_collector_id
BRIGHT_DATA_COLLECTOR_BESTBUY=c_your_bestbuy_collector_id
